# Bearer token required by Netlify to serve privateImage assets.
# Set this in Vercel > Project > Settings > Environment Variables (do NOT commit real value).
NETLIFY_PRIVATE_SECRET=

# Ed25519 PRIVATE key (hex or base64, 32 or 64 byte seed) used server-side only
# to sign mint authorization payloads consumed by the TON smart contract.
# NEVER expose this to the client / NEXT_PUBLIC_*.
AUTHENTICATION_SIGNATURE_PRIVATE_KEY=
