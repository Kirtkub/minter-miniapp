{
  "buildCommand": "npm run compile:contracts && npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/deploycollection", "destination": "/deploycollection/index.html" },
    { "source": "/deploycollection/", "destination": "/deploycollection/index.html" }
  ],
  "functions": {
    "api/deploy-notify.js": { "includeFiles": "deploy-collection/**" },
    "api/mint-notify.js": { "includeFiles": "deploy-collection/**" }
  }
}
